{
  "name": "site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "postbuild": "node scripts/check-dist-data.mjs",
    "validate": "node scripts/validate-recipes.mjs && node scripts/validate-context.mjs && node scripts/validate-prices.mjs",
    "test": "npm run test:validators && npm run test:context && npm run test:trent && npm run test:publish && npm run test:open && npm run test:forum",
    "test:validators": "node scripts/validate-prices.test.mjs",
    "test:context": "node scripts/validate-context.test.mjs",
    "test:trent": "node scripts/trent-close.test.mjs",
    "test:publish": "node scripts/publish-to-site.test.mjs",
    "test:open": "node scripts/auction-open.test.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:forum": "node scripts/forum-close.test.mjs"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
